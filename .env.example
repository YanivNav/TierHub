# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth
# BETTER_AUTH_SECRET: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# OAuth providers (register your own apps; redirect URI is
# <NEXT_PUBLIC_APP_URL>/api/auth/callback/<provider>)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Email (Resend) — for verification + password-reset emails
RESEND_API_KEY=
EMAIL_FROM="TierHub <noreply@tier-hub.net>"

# NeonDB (PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Cloudflare R2
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tierhub
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# APIs
DEEPSEEK_API_KEY=sk-...
YOUTUBE_API_KEY=

# Upstash Redis (AI rate limiting — optional; fails open if unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret guarding the Vercel Cron keepalive route (set the same value in Vercel)
CRON_SECRET=